# Copia este archivo como .env.local (no se sube al repositorio) y completa
# los valores con la salida de `npx supabase status` (entorno local).
#
# El sitio público SOLO usa la clave anónima (pública). Nunca pongas aquí la
# service role: el sitio se niega a arrancar si detecta una.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Solo desarrollo local (`npm run dev`): JIUMP_VISTA_PREVIA=1 muestra las páginas
# que están en borrador, con un aviso. En un build de producción no tiene efecto.
JIUMP_VISTA_PREVIA=
