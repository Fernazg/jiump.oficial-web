# Copia este archivo como .env.local (no se sube al repositorio) y completa
# los valores con la salida de `npx supabase status` (entorno local).
#
# El sitio público SOLO usa la clave anónima (pública). Nunca pongas la service
# role en SUPABASE_ANON_KEY: el sitio se niega a arrancar si detecta una.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Solo desarrollo local (`npm run dev`): JIUMP_VISTA_PREVIA=1 muestra las páginas
# que están en borrador, con un aviso. En un build de producción no tiene efecto.
JIUMP_VISTA_PREVIA=

# Opcional, solo para «Invitar usuario» en el panel (única acción que la usa,
# solo en el servidor; ver app/README.md › Usuarios y roles). Sin ella, el
# panel funciona igual y «Invitar» muestra un aviso. Nunca la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
