// Configuración del Worker de Cloudflare (ver docs/cloudflare.md).
// No contiene claves: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
// y SITIO_URL se cargan como variables y secretos en la cuenta de Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiump-sitio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Páginas públicas guardadas ya armadas (src/lib/paginas-guardadas.ts). Sin «id»:
  // Cloudflare crea el espacio de KV solo en el primer despliegue (gratis).
  "kv_namespaces": [{ "binding": "PAGINAS" }],
  // Conserva las variables cargadas en el panel de Cloudflare en cada despliegue.
  "keep_vars": true,
  "observability": { "enabled": true }
}
