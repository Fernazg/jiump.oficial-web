{
  "name": "jiump-sitio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "cf:build": "opennextjs-cloudflare build && node --experimental-strip-types --no-warnings scripts/cabeceras-estaticas.mjs",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "wrangler deploy",
    "predev": "node scripts/copiar-wasm.mjs",
